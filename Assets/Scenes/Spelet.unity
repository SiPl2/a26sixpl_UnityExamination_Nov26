  nextButton: {fileID: 1983134544}
  dialogue:
  - 'Du: Hej igen, jag hittade allt!'
  - 'Trummis: Fan vad nice'
  - "Du: \xC4r du fortfarande arg?"
  - "Trummis: Jag \xE4r den Arga Trummisen"
  - "Trummis: Jag \xE4r mycket arg"
  - 'Trummis: ... men kanske lite mindre nu'
  - 'Trummis: Hur som helst,'
  - "Trummis: Du kommer ut ur helvetet genom att hoppa  av kanten d\xE4r till v\xE4nster"
  - "Du: Var det seri\xF6st s\xE5 l\xE4tt?"
  - "Trummis: Det st\xE5r ju en skylt d\xE4r till och med"
  - 'Du: ...'
  - "Trummis: Aja, hejd\xE5!"
